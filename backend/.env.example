# Copy to .env for local development. Never commit real credentials.
LIVE_TRON_BIND=127.0.0.1:8080
DATABASE_URL=postgres://live_tron:change-this-local-password@127.0.0.1:5432/live_tron
LIVE_TRON_DATABASE_MAX_CONNECTIONS=10
# Generate a random secret with at least 32 bytes for local development.
LIVE_TRON_JWT_SECRET=
# Shared secret for trusted media-plane lifecycle callbacks. Leave unset until configured.
LIVE_TRON_MEDIA_EVENT_SECRET=
# Optional private API URL used by the MediaMTX lifecycle hook script.
LIVE_TRON_MEDIA_EVENT_URL=http://live-tron-api:8080/internal/v1/media/events
# Required for MediaMTX authHTTP callback; configure the same value in MTX_AUTHHTTPADDRESS.
LIVE_TRON_MEDIAMTX_AUTH_SECRET=
# Browser ICE discovery. Configure coturn REST credentials for reliable mobile/carrier connectivity.
LIVE_TRON_STUN_URLS=stun:stun.l.google.com:19302
LIVE_TRON_TURN_URLS=
LIVE_TRON_TURN_SHARED_SECRET=
# Comma-separated exact origins. Empty means cross-origin browser requests are denied.
LIVE_TRON_CORS_ORIGINS=http://localhost:5173
RUST_LOG=info
